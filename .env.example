# Dashboard Conversacional — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores

# Chave da API do OpenRouter (server-side only — NUNCA expor no client)
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo a usar via OpenRouter. O default do código é um modelo de raciocínio
# (anthropic/claude-3.5-sonnet) — essencial para a qualidade do chat: encadeia
# tools, faz análise multivariada e formata em Markdown. Evite modelos pequenos
# (ex: *-8b-instruct), que erram o roteamento de funções e empobrecem a resposta.
# Você pode apontar para um Claude mais novo se disponível na sua conta OpenRouter.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# URL de produção do app (usada pelo OpenRouter como HTTP-Referer)
NEXT_PUBLIC_APP_URL=http://localhost:3000
