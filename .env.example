# Dashboard Conversacional — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores. Todas são server-side only:
# nunca use o prefixo NEXT_PUBLIC_ numa chave.

# IA principal: DeepSeek direto (API compatível com OpenAI), raciocínio desligado no código.
# Obtenha em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Modelo da DeepSeek (padrão do código: deepseek-flash, alias do V4.x Flash)
DEEPSEEK_MODEL=deepseek-flash

# IA de reserva: OpenRouter, usada só se a DeepSeek falhar (rede, 4xx/5xx, 429, timeout).
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo da reserva no OpenRouter (padrão do código: deepseek/deepseek-v4.1-flash)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# URL de produção do app (enviada ao OpenRouter como HTTP-Referer)
NEXT_PUBLIC_APP_URL=http://localhost:3000
